# Copy this file to .env and adjust values for your local setup.
# These values are consumed by Makefile, docker compose, and backend config.

GITEA_USER=izykube
GITEA_PASSWORD=izykube123
GITEA_EMAIL=izykube@local
GITEA_REPO=izykube-gitops
GITEA_HTTP_URL=http://localhost:3001

# Backend GitOps auth (defaults to Gitea credentials in application.yaml)
GITOPS_USERNAME=izykube
GITOPS_PASSWORD=izykube123

# Optional: override when backend runs in docker compose
# GITOPS_REPO_URL=http://gitea:3000/izykube/izykube-gitops.git

# Optional: repo URL used in Argo CD Application source.
# Useful when backend runs on host but Argo runs in k3d (example below).
# GITOPS_ARGOCD_REPO_URL=http://host.k3d.internal:3001/izykube/izykube-gitops.git

