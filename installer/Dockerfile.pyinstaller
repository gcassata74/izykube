FROM python:3.12-slim-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends binutils tcl tk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY installer/requirements*.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-build.txt

COPY installer /src/installer
COPY frontend/src/assets/images/logo/izylife.png /src/frontend/src/assets/images/logo/izylife.png
RUN pyinstaller --clean --noconfirm installer/IzyKubeSetup.spec

FROM scratch AS artifact
COPY --from=builder /src/dist/IzyKubeSetup /IzyKubeSetup
